#!/usr/bin/env python3
from __future__ import annotations

import argparse
import html
import json
import os
import re
import secrets
import subprocess
import sys
import time
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from typing import Any
from urllib.parse import parse_qs, urlparse


DEFAULT_REGISTRY = "/srv/openclaw-ops/slots.yaml"
DEFAULT_IMAGES = "/srv/openclaw-ops/images.yaml"
DEFAULT_MANIFEST = "/opt/openclaw-nas-agent-baseline/.openclaw-baseline-manifest"
DEFAULT_HEALTH_REPORT = "/srv/openclaw-ops/reports/health-latest.txt"
DEFAULT_DRIFT_REPORT = DEFAULT_HEALTH_REPORT
DEFAULT_ACTIONS_LOG = "/srv/openclaw-ops/reports/actions.log"
DEFAULT_CONTROL = "/opt/openclaw-nas-agent-baseline/scripts/svcops-control.sh"
DEFAULT_MAX_OUTPUT_BYTES = 32 * 1024
DEFAULT_BASE_URL = "http://openclaw-shared-ollama:11434/v1"
DEFAULT_OLLAMA_MODEL = "qwen2.5-coder:7b"

SLOT_RE = re.compile(r"^(oc[1-9][0-9]*|dev-oc|dev-hermess)$")
SHARE_RE = re.compile(r"^//[^\s/,]+/[^\s/,]+$")
MODEL_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:+/\-]{0,127}$")
BASE_URL_RE = re.compile(r"^https?://[A-Za-z0-9._:\-/]+$")
SINCE_RE = re.compile(r"^[0-9]+[mhd]$")
QUERY_RE = re.compile(r"^[^\r\n]{1,160}$")
IMAGE_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:@/\-]{0,255}$")
CHANNEL_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
SLOT_NUMBER_RE = re.compile(r"^[0-9]{1,3}$")

SECRET_VALUE_RE = re.compile(
    r"(?i)\b([A-Za-z0-9_]*(?:api[_-]?key|token|password|passwd|credential|secret)[A-Za-z0-9_]*)"
    r"(\s*[=:]\s*)(['\"]?)([^\s'\"\r\n]+)"
)
BEARER_RE = re.compile(r"(?i)\b(Bearer\s+)[A-Za-z0-9._~+/=-]+")
KEY_LIKE_RE = re.compile(r"\b(sk-[A-Za-z0-9]{12,}|AIza[0-9A-Za-z_\-]{20,})\b")
SENSITIVE_PARAM_KEYS = ("pass", "password", "token", "secret", "credential", "api_key", "apikey", "key")


def now_iso() -> str:
    return datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")


def unquote_yaml(value: str) -> str:
    value = value.strip()
    if value.startswith('"') and value.endswith('"'):
        return value[1:-1]
    if value.startswith("'") and value.endswith("'"):
        return value[1:-1]
    return value


def read_text(path: Path, max_bytes: int = 1024 * 1024) -> str:
    try:
        with path.open("rb") as handle:
            data = handle.read(max_bytes + 1)
    except FileNotFoundError:
        return ""
    if len(data) > max_bytes:
        data = data[:max_bytes] + b"\n[truncated]\n"
    return data.decode("utf-8", errors="replace")


def parse_key_values(text: str) -> dict[str, str]:
    result: dict[str, str] = {}
    for line in text.splitlines():
        line = line.lstrip("\ufeff")
        if "=" not in line:
            continue
        if not re.match(r"^[A-Za-z0-9_]+=", line):
            continue
        key, value = line.split("=", 1)
        key = key.lstrip("\ufeff")
        result[key] = value
    return result


def count_pending_nas_requests(text: str) -> int:
    return sum(1 for line in text.splitlines() if line.strip() == "share_request=present")


def parse_key_value_file(path: Path) -> dict[str, str]:
    return parse_key_values(read_text(path, max_bytes=64 * 1024))


def parse_registry(path: Path) -> tuple[dict[str, str], list[dict[str, str]]]:
    text = read_text(path)
    meta: dict[str, str] = {}
    slots: list[dict[str, str]] = []
    section = ""
    current: dict[str, str] | None = None
    nested = ""

    for raw in text.splitlines():
        line = raw.rstrip().lstrip("\ufeff")
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        indent = len(line) - len(line.lstrip(" "))
        if stripped == "meta:":
            section = "meta"
            current = None
            nested = ""
            continue
        if stripped == "slots:":
            section = "slots"
            current = None
            nested = ""
            continue
        if section == "meta" and indent == 2 and ":" in stripped:
            key, value = stripped.split(":", 1)
            meta[key] = unquote_yaml(value)
            continue
        if section != "slots":
            continue
        if indent == 2 and stripped.startswith("- slot:"):
            if current:
                slots.append(current)
            current = {"slot": unquote_yaml(stripped.split(":", 1)[1])}
            nested = ""
            continue
        if current is None:
            continue
        if indent == 4 and stripped.endswith(":"):
            nested = stripped[:-1]
            continue
        if indent == 4 and ":" in stripped:
            key, value = stripped.split(":", 1)
            current[key] = unquote_yaml(value)
            nested = ""
            continue
        if indent == 6 and nested and ":" in stripped:
            key, value = stripped.split(":", 1)
            current[f"{nested}.{key}"] = unquote_yaml(value)

    if current:
        slots.append(current)
    slots.sort(key=lambda item: slot_number(item.get("slot", "")))
    return meta, slots


def parse_image_catalog(path: Path) -> dict[str, Any]:
    state: dict[str, Any] = {"exists": path.exists(), "channels": {}, "images": []}
    text = read_text(path)
    section = ""
    current: dict[str, str] | None = None
    alias_mode = False

    for raw in text.splitlines():
        line = raw.rstrip().lstrip("\ufeff")
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        indent = len(line) - len(line.lstrip(" "))
        if stripped == "channels:":
            section = "channels"
            current = None
            alias_mode = False
            continue
        if stripped == "images:":
            section = "images"
            current = None
            alias_mode = False
            continue
        if section == "channels" and indent == 2 and ":" in stripped:
            key, value = stripped.split(":", 1)
            state["channels"][key] = unquote_yaml(value)
            continue
        if section == "images" and indent == 2 and stripped.startswith("- name:"):
            if current:
                state["images"].append(current)
            current = {"name": unquote_yaml(stripped.split(":", 1)[1]), "aliases": ""}
            alias_mode = False
            continue
        if section == "images" and current is not None:
            if indent == 4 and stripped == "aliases:":
                alias_mode = True
                continue
            if alias_mode and indent == 6 and stripped.startswith("- "):
                aliases = [item for item in current.get("aliases", "").split(",") if item]
                aliases.append(unquote_yaml(stripped[2:]))
                current["aliases"] = ",".join(aliases)
                continue
            alias_mode = False
            if indent == 4 and ":" in stripped:
                key, value = stripped.split(":", 1)
                current[key] = unquote_yaml(value)
                continue

    if current:
        state["images"].append(current)
    return state


def slot_number(slot: str) -> int:
    match = re.search(r"(\d+)$", slot or "")
    return int(match.group(1)) if match else 10_000


def infer_lane(slot: dict[str, str]) -> str:
    name = slot.get("slot", "")
    lane = slot.get("lane", "")
    if lane:
        return lane
    if name == "dev-oc":
        return "dev-openclaw"
    if name == "dev-hermess":
        return "dev-hermes"
    legacy_channel = slot.get("image_channel", "")
    if legacy_channel in {"openclaw", "hermes", "hold"}:
        return legacy_channel
    legacy_name = slot.get("image_name", "") or slot.get("image_tag", "")
    if legacy_name.startswith("hermes-"):
        return "hermes"
    match = re.match(r"^oc([0-9]+)$", name)
    if match and int(match.group(1)) >= 15:
        return "hermes"
    return "openclaw"


def parse_drift_report(path: Path) -> dict[str, Any]:
    text = read_text(path)
    top: dict[str, str] = {}
    slots: dict[str, dict[str, Any]] = {}
    current = ""
    top_level_keys = {
        "health_check_started",
        "drift_check_started",
        "registry",
        "image_registry",
        "manifest",
        "slot_count",
        "installed_baseline_commit",
        "baseline_manifest",
        "health_check_finished",
        "drift_check_finished",
        "summary",
        "failures",
        "warnings",
    }

    for line in text.splitlines():
        stripped = line.strip()
        if not stripped:
            continue
        if "=" in stripped:
            key, value = stripped.split("=", 1)
            if key in top_level_keys:
                top[key] = value
                continue
        match = re.match(r"^==\s+((?:oc[0-9]+)|dev-oc|dev-hermess)\s+==$", stripped)
        if match:
            current = match.group(1)
            slots[current] = {"lines": []}
            continue
        if current:
            slots[current]["lines"].append(stripped)
            if "=" in stripped:
                key, value = stripped.split("=", 1)
                slots[current][key] = value
            continue
        if "=" in stripped:
            key, value = stripped.split("=", 1)
            top[key] = value

    return {
        "exists": bool(text),
        "summary": top.get("summary", "missing"),
        "failures": int(top.get("failures", "0") or 0) if top.get("failures", "0").isdigit() else None,
        "warnings": int(top.get("warnings", "0") or 0) if top.get("warnings", "0").isdigit() else None,
        "started": top.get("health_check_started", top.get("drift_check_started", "")),
        "finished": top.get("health_check_finished", top.get("drift_check_finished", "")),
        "top": top,
        "slots": slots,
    }


def redact(text: str) -> str:
    text = SECRET_VALUE_RE.sub(lambda m: f"{m.group(1)}{m.group(2)}{m.group(3)}[REDACTED]", text)
    text = BEARER_RE.sub(lambda m: f"{m.group(1)}[REDACTED]", text)
    text = KEY_LIKE_RE.sub("[REDACTED_KEY]", text)
    return text


def limit_output(text: str, max_bytes: int) -> tuple[str, bool]:
    data = text.encode("utf-8", errors="replace")
    if len(data) <= max_bytes:
        return text, False
    clipped = data[:max_bytes].decode("utf-8", errors="replace")
    return clipped + "\n[output truncated]\n", True


def sanitize_params(params: dict[str, Any]) -> dict[str, Any]:
    clean: dict[str, Any] = {}
    for key, value in params.items():
        lowered = key.lower()
        if key == "csrf":
            continue
        if key == "confirm":
            continue
        if key == "query":
            clean[key] = f"[QUERY length={len(str(value))}]"
            continue
        if any(item in lowered for item in SENSITIVE_PARAM_KEYS):
            clean[key] = "[REDACTED]"
        else:
            clean[key] = value
    return clean


def validate_loopback(host: str) -> None:
    if host not in ("127.0.0.1", "localhost", "::1"):
        raise SystemExit("error: openclaw-ops-console only binds to loopback in v1")


class ControlRunner:
    def __init__(self, control: str, use_sudo: bool, max_output_bytes: int):
        self.control = control
        self.use_sudo = use_sudo
        self.max_output_bytes = max_output_bytes

    def command(self, args: list[str]) -> list[str]:
        if self.use_sudo:
            return ["sudo", "-n", self.control, *args]
        return [self.control, *args]

    def run(self, args: list[str], timeout: int = 120) -> dict[str, Any]:
        started = time.monotonic()
        cmd = self.command(args)
        try:
            proc = subprocess.run(
                cmd,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=timeout,
            )
            output = proc.stdout or ""
            exit_code = proc.returncode
        except TimeoutError:
            output = "TIMEOUT\n"
            exit_code = 124
        except subprocess.TimeoutExpired as exc:
            output = (exc.stdout or "") + "\nTIMEOUT\n"
            exit_code = 124
        except OSError as exc:
            output = f"ERROR: {exc}\n"
            exit_code = 127
        duration_ms = int((time.monotonic() - started) * 1000)
        output = redact(output)
        output, truncated = limit_output(output, self.max_output_bytes)
        return {
            "args": args,
            "exit_code": exit_code,
            "duration_ms": duration_ms,
            "output": output,
            "truncated": truncated,
        }


def append_action_log(path: Path, event: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    data = (json.dumps(event, ensure_ascii=False, sort_keys=True) + "\n").encode("utf-8")
    fd = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    try:
        os.write(fd, data)
    finally:
        os.close(fd)


def read_recent_actions(path: Path, count: int = 12) -> list[dict[str, Any]]:
    text = read_text(path, max_bytes=512 * 1024)
    rows: list[dict[str, Any]] = []
    for line in text.splitlines()[-count:]:
        try:
            rows.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return rows


def valid_slot(value: str) -> str:
    if not SLOT_RE.match(value or ""):
        raise ValueError("invalid slot")
    return value


def valid_share(value: str) -> str:
    if not SHARE_RE.match(value or ""):
        raise ValueError("invalid NAS share")
    return value


def truthy_param(params: dict[str, Any], key: str) -> bool:
    return first_param(params, key).lower() in {"1", "true", "yes", "on"}


def valid_model(value: str) -> str:
    if not MODEL_RE.match(value or ""):
        raise ValueError("invalid model")
    return value


def valid_base_url(value: str) -> str:
    if not BASE_URL_RE.match(value or ""):
        raise ValueError("invalid base URL")
    return value


def valid_since(value: str) -> str:
    if not SINCE_RE.match(value or ""):
        raise ValueError("invalid since window")
    return value


def valid_query(value: str) -> str:
    if not QUERY_RE.match(value or ""):
        raise ValueError("invalid search query")
    return value


def valid_image(value: str) -> str:
    if not IMAGE_NAME_RE.match(value or ""):
        raise ValueError("invalid image")
    return value


def valid_channel(value: str) -> str:
    if not CHANNEL_RE.match(value or ""):
        raise ValueError("invalid image channel")
    return value


def valid_slot_number(value: str) -> str:
    if not SLOT_NUMBER_RE.match(value or ""):
        raise ValueError("invalid slot number")
    number = int(value)
    if number < 1 or number > 999:
        raise ValueError("slot number out of range")
    return str(number)


def first_param(params: dict[str, Any], key: str, default: str = "") -> str:
    value = params.get(key, default)
    if isinstance(value, list):
        return str(value[0]) if value else default
    return str(value)


def host_for_slot(slot: str, registry_slots: list[dict[str, str]], base_domain: str) -> str:
    for item in registry_slots:
        if item.get("slot") == slot:
            return item.get("subdomain") or f"{slot}.{base_domain}"
    return f"{slot}.{base_domain}"


def extract_requested_share(text: str, slot: str) -> str:
    in_slot = False
    for line in text.splitlines():
        match = re.match(r"^==\s+((?:oc[0-9]+)|dev-oc|dev-hermess)\s+==$", line.strip())
        if match:
            in_slot = match.group(1) == slot
            continue
        if in_slot and line.startswith("requested_share="):
            return line.split("=", 1)[1].strip()
    return ""


class OpsConsole:
    def __init__(self, args: argparse.Namespace):
        self.host = args.host
        self.port = args.port
        self.registry = Path(args.registry)
        self.images = Path(args.images)
        self.manifest = Path(args.manifest)
        self.drift_report = Path(args.health_report or args.drift_report)
        self.actions_log = Path(args.actions_log)
        self.base_domain = args.base_domain
        self.csrf = secrets.token_urlsafe(32)
        self.runner = ControlRunner(args.control, not args.no_sudo, args.max_output_bytes)

    def registry_state(self) -> tuple[dict[str, str], list[dict[str, str]]]:
        return parse_registry(self.registry)

    def summary(self) -> dict[str, Any]:
        meta, slots = self.registry_state()
        image_catalog = parse_image_catalog(self.images)
        manifest = parse_key_value_file(self.manifest)
        drift = parse_drift_report(self.drift_report)
        installed_commit = manifest.get("source_commit", "")
        registry_commit = ""
        baseline_match = bool(installed_commit)
        drift_slots = drift.get("slots", {})

        merged_slots: list[dict[str, Any]] = []
        for slot in slots:
            name = slot.get("slot", "")
            drift_slot = drift_slots.get(name, {})
            lane = infer_lane(slot)
            slot_type = "dev" if name in {"dev-oc", "dev-hermess"} else "customer"
            customer_nas_live = drift_slot.get("customer_nas_live", "")
            container_nas_live = drift_slot.get("container_nas_live", "")
            merged_slots.append(
                {
                    "slot": name,
                    "lane": lane,
                    "slot_type": slot.get("slot_type", slot_type),
                    "slot_mode": slot.get("slot_mode", "source" if slot_type == "dev" else "image"),
                    "status": slot.get("status", ""),
                    "assignee": slot.get("assignee", ""),
                    "subdomain": slot.get("subdomain", ""),
                    "nas_share": customer_nas_live,
                    "mount_name": container_nas_live,
                    "customer_nas_live": customer_nas_live,
                    "container_nas_live": container_nas_live,
                    "dashboard_name": slot.get("dashboard_name", ""),
                    "image_tag": slot.get("image_tag", ""),
                    "image_channel": slot.get("image_channel", ""),
                    "image_name": slot.get("image_name", ""),
                    "expected_image_name": drift_slot.get("expected_image_name", ""),
                    "expected_image_family": drift_slot.get("expected_image_family", ""),
                    "expected_image_source_repo": drift_slot.get("expected_image_source_repo", ""),
                    "expected_image_source_ref": drift_slot.get("expected_image_source_ref", ""),
                    "expected_image_agent_source_repo": drift_slot.get("expected_image_agent_source_repo", ""),
                    "expected_image_agent_source_ref": drift_slot.get("expected_image_agent_source_ref", ""),
                    "expected_image_workspace_source_repo": drift_slot.get("expected_image_workspace_source_repo", ""),
                    "expected_image_workspace_source_ref": drift_slot.get("expected_image_workspace_source_ref", ""),
                    "expected_image_base": drift_slot.get("expected_image_base", ""),
                    "expected_image_workspace": drift_slot.get("expected_image_workspace", ""),
                    "expected_image_ref": drift_slot.get("expected_image_ref", ""),
                    "expected_image_status": drift_slot.get("expected_image_status", ""),
                    "actual_image_line": drift_slot.get("image", ""),
                    "gate_status": slot.get("last_gate.status", ""),
                    "gate_checked_at": slot.get("last_gate.checked_at", ""),
                    "handoff_ssh": slot.get("handoff.ssh", ""),
                    "handoff_token": slot.get("handoff.token", ""),
                    "handoff_url": slot.get("handoff.url", ""),
                    "drift_result": drift_slot.get("result", "missing"),
                    "drift_lines": drift_slot.get("lines", []),
                }
            )

        ollama = self.runner.run(["shared-ollama-status"], timeout=30)
        usage = self.runner.run(["usage-all", "1", "20", "24h"], timeout=90)
        nas_requests = self.runner.run(["nas-requests", "1", "20"], timeout=90)

        return {
            "generated_at": now_iso(),
            "registry": str(self.registry),
            "images_path": str(self.images),
            "manifest": str(self.manifest),
            "meta": meta,
            "manifest_values": manifest,
            "baseline": {
                "registry_commit": registry_commit,
                "installed_commit": installed_commit,
                "match": baseline_match,
                "image_tag": meta.get("image_tag", ""),
                "image_id": meta.get("image_id", ""),
            },
            "image_catalog": image_catalog,
            "drift": drift,
            "slots": merged_slots,
            "slot_count": len(merged_slots),
            "failed_slots": len([slot for slot in merged_slots if slot.get("drift_result") == "FAIL"]),
            "ollama_status": ollama,
            "usage_summary": usage,
            "nas_requests": nas_requests,
            "nas_pending_requests": count_pending_nas_requests(nas_requests.get("output", "")),
            "recent_actions": read_recent_actions(self.actions_log),
            "external_integrations": {
                "groupware_mail": "pending_external_access",
                "kakaowork": "pending_external_access",
            },
        }

    def slot_detail(self, slot: str) -> dict[str, Any]:
        valid_slot(slot)
        commands = {
            "nas-status": ["nas-status", slot],
            "nas-tree": ["nas-tree", slot],
            "heartbeat-status": ["heartbeat-status", slot],
            "image-status": ["image-status", slot],
            "usage": ["usage", slot, "24h"],
        }
        outputs = {name: self.runner.run(args, timeout=90) for name, args in commands.items()}
        return {"slot": slot, "commands": outputs}

    def action_args(self, action: str, params: dict[str, Any]) -> tuple[list[str], int]:
        meta, slots = self.registry_state()
        del meta
        slot = first_param(params, "slot")
        since = first_param(params, "since", "24h")
        model = first_param(params, "model", DEFAULT_OLLAMA_MODEL)
        base_url = first_param(params, "base_url", DEFAULT_BASE_URL)
        confirm = first_param(params, "confirm")
        share = first_param(params, "share")
        query = first_param(params, "query")
        image = first_param(params, "image")
        image_ref = first_param(params, "image_ref")
        channel = first_param(params, "channel")
        image_start = first_param(params, "image_start", "1")
        image_end = first_param(params, "image_end", "20")

        if action in {
            "check",
            "nas-status",
            "nas-verify",
            "nas-tree",
            "nas-search-smoke",
            "usage",
            "heartbeat-status",
            "image-status",
            "gateway-refresh",
            "heartbeat-disable",
            "heartbeat-ollama",
            "ollama-provider",
            "ollama-default",
            "shared-ollama-smoke",
            "nas-approve-share",
            "nas-register",
            "nas-unregister",
            "image-rollout-slot",
            "image-rollback",
            "dev-slot-status",
            "source-mode-status",
            "source-mode-enable",
            "source-mode-disable",
        }:
            slot = valid_slot(slot)

        if action == "check":
            return ["check", slot, host_for_slot(slot, slots, self.base_domain)], 240
        if action == "nas-status":
            return ["nas-status", slot], 90
        if action == "nas-verify":
            return ["nas-verify", slot], 180
        if action == "nas-tree":
            return ["nas-tree", slot], 90
        if action == "nas-search-smoke":
            return ["nas-search-smoke", slot, valid_query(query)], 90
        if action == "usage":
            return ["usage", slot, valid_since(since)], 90
        if action == "heartbeat-status":
            return ["heartbeat-status", slot], 90
        if action == "image-status":
            return ["image-status", slot], 60
        if action == "image-list":
            return ["image-list"], 60
        if action == "image-status-all":
            return ["image-status-all", "1", "20"], 120
        if action == "image-release-add":
            args = ["image-release-add", valid_image(image_ref)]
            if image:
                args.append(valid_image(image))
            return args, 900
        if action == "image-release-verify":
            return ["image-release-verify", valid_image(image)], 900
        if action == "image-release-promote":
            return ["image-release-promote", valid_image(image), valid_channel(channel)], 120
        if action == "image-rollout":
            return ["image-rollout", valid_channel(channel)], 1200
        if action == "image-rollout-range":
            start = valid_slot_number(image_start)
            end = valid_slot_number(image_end)
            if int(start) > int(end):
                raise ValueError("image rollout start must be less than or equal to end")
            expected_confirm = f"{start}-{end}"
            if confirm != expected_confirm:
                raise ValueError(f"image-rollout-range requires confirm={expected_confirm}")
            return ["image-rollout-range", start, end, valid_image(image)], 2400
        if action == "image-rollout-slot":
            return ["image-rollout-slot", slot, valid_image(image)], 300
        if action == "image-rollback":
            return ["image-rollback", slot], 300
        if action == "dev-slot-status":
            return ["dev-slot-status", slot], 90
        if action == "source-mode-status":
            return ["source-mode-status", slot], 90
        if action == "source-mode-enable":
            return ["source-mode-enable", slot], 240
        if action == "source-mode-disable":
            return ["source-mode-disable", slot], 240
        if action == "shared-ollama-status":
            return ["shared-ollama-status"], 60
        if action == "shared-ollama-smoke":
            args = ["shared-ollama-smoke", slot]
            if model:
                args.append(valid_model(model))
            return args, 180
        if action == "gateway-refresh":
            return ["gateway-refresh", slot], 180
        if action == "heartbeat-disable":
            return ["heartbeat-disable", slot], 180
        if action == "heartbeat-ollama":
            return ["heartbeat-ollama", slot, valid_model(model), valid_base_url(base_url)], 180
        if action == "ollama-provider":
            return ["ollama-provider", slot, valid_model(model), valid_base_url(base_url)], 180
        if action == "ollama-default":
            return ["ollama-default", slot, valid_model(model), valid_base_url(base_url)], 180
        if action == "nas-requests":
            return ["nas-requests", "1", "20"], 90
        if action == "nas-approve-share":
            if confirm != slot:
                raise ValueError("nas-approve-share requires confirming the slot")
            return ["nas-approve-share", slot], 180
        if action == "nas-register":
            share = valid_share(share)
            if confirm != share:
                raise ValueError("nas-register requires confirming the NAS share")
            return ["nas-register", slot, share], 180
        if action == "nas-unregister":
            share = valid_share(share)
            if confirm != share:
                raise ValueError("nas-unregister requires confirming the NAS share")
            args = ["nas-unregister", slot, share]
            if truthy_param(params, "nas_unmount"):
                args.append("--unmount")
            if truthy_param(params, "delete_credential"):
                args.append("--delete-credential")
            if truthy_param(params, "delete_empty_dir"):
                args.append("--delete-empty-dir")
            return args, 180
        raise ValueError("unsupported action")

    def execute_action(self, action: str, params: dict[str, Any]) -> dict[str, Any]:
        params = dict(params)
        if action == "nas-approve-share":
            slot = valid_slot(first_param(params, "slot"))
            request_probe = self.runner.run(["nas-requests", "1", "20"], timeout=90)
            requested_share = extract_requested_share(request_probe["output"], slot)
            if not requested_share:
                raise ValueError("no requested NAS share is visible for this slot")
            params["requested_share"] = requested_share

        args, timeout = self.action_args(action, params)
        actor = os.environ.get("USER") or os.environ.get("LOGNAME") or os.environ.get("USERNAME") or "unknown"
        slot = first_param(params, "slot")
        started_at = now_iso()
        result = self.runner.run(args, timeout=timeout)
        event = {
            "timestamp": started_at,
            "actor": actor,
            "action": action,
            "slot": slot,
            "params": sanitize_params(params),
            "exit_code": result["exit_code"],
            "duration_ms": result["duration_ms"],
            "result_summary": "\n".join(result["output"].splitlines()[:12])[:2048],
        }
        append_action_log(self.actions_log, event)
        return {"event": event, "result": result}


