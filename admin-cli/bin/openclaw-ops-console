  <script>
    const CSRF = __CSRF__;
    let state = null;
    let selectedSlot = "";

    function esc(value) {
      return String(value ?? "").replace(/[&<>"']/g, ch => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[ch]));
    }
    function cls(value) {
      const text = String(value || "").toLowerCase();
      if (["pass", "ready", "ok", "match", "active_test"].includes(text)) return "ok";
      if (["fail", "failed", "mismatch"].includes(text)) return "bad";
      if (["warn", "warning", "missing", "assigned", "paused", "turnover_needed"].includes(text)) return "warn";
      return "";
    }
    function pill(value) {
      const text = String(value || "missing");
      const kind = cls(text);
      return `<span class="pill ${kind}">${esc(text)}</span>`;
    }
    function metric(label, value, kind = "", hint = "") {
      return `<div class="metric"><div class="label">${esc(label)}</div><div class="value ${kind}">${esc(value)}</div><div class="hint">${esc(hint)}</div></div>`;
    }
    function needsAttention(slot) {
      return ["FAIL", "missing"].includes(slot.drift_result) || slot.gate_status === "fail" || ["paused", "revoked", "turnover_needed"].includes(slot.status);
    }
    async function fetchJson(url, options = {}) {
      const response = await fetch(url, options);
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || response.statusText);
      return data;
    }
    async function refreshSummary() {
      document.getElementById("summary").innerHTML = metric("Loading", "...", "", "Reading server state");
      state = await fetchJson("/api/summary");
      renderSummary();
      renderSlots();
      if (!selectedSlot && state.slots.length) selectSlot(state.slots[0].slot);
    }
    function renderSummary() {
      const health = state.drift || {};
      const baseline = state.baseline || {};
      const ollama = state.ollama_status || {};
      const usage = state.usage_summary || {};
      const catalog = state.image_catalog || {};
      const imageCount = (catalog.images || []).length;
      const channelCount = Object.keys(catalog.channels || {}).length;
      const attention = state.slots.filter(needsAttention).length;
      document.getElementById("summary").innerHTML = [
        metric("Baseline", baseline.match ? "match" : "mismatch", baseline.match ? "ok" : "bad", (baseline.installed_commit || "").slice(0, 12)),
        metric("Health", health.summary || "missing", health.summary === "PASS" ? "ok" : "bad", health.finished || "no report"),
        metric("Attention slots", attention, attention ? "warn-text" : "ok", `failed=${state.failed_slots || 0} / total=${state.slot_count || 0}`),
        metric("NAS pending", state.nas_pending_requests || 0, state.nas_pending_requests ? "warn-text" : "ok", "grant policy requests"),
        metric("Ollama", ollama.exit_code === 0 ? "ok" : "check", ollama.exit_code === 0 ? "ok" : "warn-text", "shared local model"),
        metric("Images", imageCount || "none", imageCount ? "ok" : "warn-text", `channels=${channelCount}`),
      ].join("");
      document.getElementById("refreshedAt").textContent = `Updated ${state.generated_at || ""}`;
    }
    function renderSlots() {
      const tbody = document.getElementById("slots");
      const query = document.getElementById("slotSearch").value.trim().toLowerCase();
      const filter = document.getElementById("slotFilter").value;
      const rows = state.slots.filter(slot => {
        const haystack = [slot.slot, slot.lane, slot.status, slot.subdomain, slot.customer_nas_live, slot.container_nas_live].join(" ").toLowerCase();
        if (query && !haystack.includes(query)) return false;
        if (filter === "attention") return needsAttention(slot);
        if (filter === "ready") return slot.status === "ready";
        if (filter === "active_test") return slot.status === "active_test";
        return true;
      });
      document.getElementById("slotCountLabel").textContent = `${rows.length} / ${state.slots.length}`;
      tbody.innerHTML = rows.map(slot => `
        <tr onclick="selectSlot('${esc(slot.slot)}')" data-selected="${slot.slot === selectedSlot}" data-attention="${needsAttention(slot)}">
          <td><strong>${esc(slot.slot)}</strong><div class="subline">${esc(slot.slot_type || "")}</div></td>
          <td>${esc(slot.lane || "")}<div class="subline">${esc(slot.status || "")}</div></td>
          <td>${esc(slot.subdomain || "")}<div class="subline">${esc(slot.handoff_url || "")}</div></td>
          <td>${esc(slot.container_nas_live || "missing")}<div class="subline">${esc(slot.customer_nas_live || "")}</div></td>
          <td>${pill(slot.gate_status || "unknown")}<div class="subline">${esc(slot.gate_checked_at || "")}</div></td>
          <td>${pill(slot.drift_result)}</td>
        </tr>`).join("");
    }
    function selectSlot(slot) {
      selectedSlot = slot;
      renderSlots();
      const item = state.slots.find(row => row.slot === slot) || {};
      const sourceRef = item.expected_image_source_ref ? item.expected_image_source_ref.slice(0, 12) : "-";
      const agentRef = item.expected_image_agent_source_ref ? item.expected_image_agent_source_ref.slice(0, 12) : "-";
      const workspaceRef = item.expected_image_workspace_source_ref ? item.expected_image_workspace_source_ref.slice(0, 12) : "-";
      const isHermes = (item.expected_image_family || item.lane || "").includes("hermes");
      document.getElementById("detailTitle").textContent = `${slot} Detail`;
      document.getElementById("slotMeta").textContent = `${item.subdomain || ""} ? lane ${item.lane || ""} ? NAS ${item.container_nas_live || item.customer_nas_live || "missing"}`;
      const cards = [
        card("Mode", item.slot_mode || "-", item.slot_type || "-"),
        card("Status", pill(item.status), item.gate_checked_at || ""),
        card("Health", pill(item.drift_result), needsAttention(item) ? "needs attention" : "normal"),
        card("Expected image", item.expected_image_name || item.image_name || "-", item.expected_image_status || item.image_channel || ""),
        card("Running image", item.actual_image_line || "-", item.expected_image_ref || item.image_tag || ""),
      ];
      if (isHermes) {
        cards.splice(4, 0,
          card("Agent source", agentRef, item.expected_image_agent_source_repo || item.expected_image_base || ""),
          card("Workspace source", workspaceRef, item.expected_image_workspace_source_repo || item.expected_image_workspace || "")
        );
      } else {
        cards.splice(4, 0, card("Source ref", sourceRef, item.expected_image_source_repo || item.expected_image_base || ""));
      }
      document.getElementById("slotCards").innerHTML = cards.join("");
      document.getElementById("nasTreeMeta").textContent = "No NAS tree loaded.";
      document.getElementById("nasTree").innerHTML = "";
    }
    function card(label, value, hint = "") {
      return `<div class="card"><div class="label">${esc(label)}</div><div class="value">${String(value).startsWith("<") ? value : esc(value)}</div><div class="hint">${esc(hint)}</div></div>`;
    }
    function parseKv(output) {
      const meta = {};
      for (const line of (output || "").split("\n")) {
        const m = line.match(/^([A-Za-z0-9_]+)=(.*)$/);
        if (m) meta[m[1]] = m[2];
      }
      return meta;
    }
    function renderNasTree(output) {
      const meta = parseKv(output || "");
      const rows = [];
      for (const line of (output || "").split("\n")) {
        if (!line.startsWith("TREE ")) continue;
        try { rows.push(JSON.parse(line.slice(5))); } catch (_) {}
      }
      const status = meta.tree_status || meta.root_state || "unknown";
      const root = meta.container_root || "runtime NAS root";
      document.getElementById("nasTreeMeta").innerHTML = `${esc(root)} ? ${pill(status)} ? entries ${esc(meta.tree_entries_reported || rows.length)}`;
      document.getElementById("nasTree").innerHTML = rows.length ? rows.map(row => {
        const depth = Math.max(0, Math.min(Number(row.depth || 0), 8));
        const kind = row.kind || "unknown";
        const details = [];
        for (const key of ["state", "view", "mount_state", "fstype", "dir_count", "file_count", "entry_count", "omitted", "size"]) {
          if (row[key] !== undefined) details.push(`${key}=${row[key]}`);
        }
        return `<div class="tree-row" style="padding-left:${depth * 18}px"><span>${kind === "dir" || kind === "root" ? "[dir]" : "[file]"}</span><span>${esc(row.path || "")}</span><span class="muted">${esc(details.join(" | "))}</span></div>`;
      }).join("") : `<div class="tree-row"><span>${esc(status)}</span><span>${esc(meta.container_status || meta.root_state || "no tree rows")}</span><span></span></div>`;
    }
    async function loadSlotDetail() {
      if (!selectedSlot) return;
      setOutput("Loading slot status...");
      const data = await fetchJson(`/api/slot?slot=${encodeURIComponent(selectedSlot)}`);
      if (data.commands && data.commands["nas-tree"]) renderNasTree(data.commands["nas-tree"].output);
      setOutput(Object.entries(data.commands).map(([name, result]) => `## ${name}\nexit=${result.exit_code} duration_ms=${result.duration_ms}\n${result.output}`).join("\n\n"), "slot status");
    }
    async function loadNasTree() { if (selectedSlot) await runAction(params("nas-tree")); }
    function params(action) {
      return {
        action, slot: selectedSlot,
        model: document.getElementById("model").value,
        base_url: document.getElementById("baseUrl").value,
        share: document.getElementById("share").value,
        nas_unmount: document.getElementById("nasUnmount").checked,
        delete_credential: document.getElementById("deleteCredential").checked,
        delete_empty_dir: document.getElementById("deleteEmptyDir").checked,
        confirm: document.getElementById("confirm").value,
        query: document.getElementById("searchQuery").value,
        image_ref: document.getElementById("imageRef").value,
        image: document.getElementById("imageName").value,
        channel: document.getElementById("imageChannel").value,
        image_start: document.getElementById("imageStart").value,
        image_end: document.getElementById("imageEnd").value,
        since: "24h"
      };
    }
    function updateNasActionState() {
      const unlocked = document.getElementById("nasUnlock").checked;
      for (const button of document.querySelectorAll(".nas-action")) button.disabled = !unlocked || document.body.classList.contains("is-busy");
    }
    function setBusy(isBusy) {
      document.body.classList.toggle("is-busy", isBusy);
      for (const button of document.querySelectorAll("button:not(.nas-action)")) button.disabled = isBusy;
      updateNasActionState();
    }
    async function runSlotAction(action) {
      if (!selectedSlot) return;
      if (["nas-approve-share", "nas-register", "nas-unregister"].includes(action) && !document.getElementById("nasUnlock").checked) {
        setOutput("Enable NAS change buttons first.", action);
        return;
      }
      await runAction(params(action));
    }
    async function runGlobalAction(action) {
      await runAction({
        action,
        image_ref: document.getElementById("imageRef").value,
        image: document.getElementById("imageName").value,
        channel: document.getElementById("imageChannel").value,
        image_start: document.getElementById("imageStart").value || "1",
        image_end: document.getElementById("imageEnd").value || "20",
        confirm: document.getElementById("imageConfirm").value || ""
      });
    }
    async function runAction(payload) {
      setOutput("Running...");
      setBusy(true);
      try {
        const data = await fetchJson("/api/action", {method: "POST", headers: {"Content-Type": "application/json", "X-CSRF-Token": CSRF}, body: JSON.stringify(payload)});
        const result = data.result;
        setOutput(`exit=${result.exit_code} duration_ms=${result.duration_ms}\n${result.output}`, payload.action);
        if (payload.action === "nas-tree") renderNasTree(result.output);
        if (result.exit_code === 0) await refreshSummary();
      } catch (error) {
        setOutput(`ERROR: ${error.message}`, payload.action);
      } finally {
        setBusy(false);
      }
    }
    function setOutput(text, label = "") {
      document.getElementById("output").textContent = text;
      document.getElementById("lastRun").textContent = label;
    }
    updateNasActionState();
    refreshSummary().catch(error => setOutput(`ERROR: ${error.message}`, "summary"));
  </script>
</body>
</html>
""".replace("__CSRF__", token)


class RequestHandler(BaseHTTPRequestHandler):
    server_version = "OpenClawOpsConsole/1.0"

    @property
    def app(self) -> OpsConsole:
        return self.server.app  # type: ignore[attr-defined]

    def log_message(self, fmt: str, *args: Any) -> None:
        sys.stderr.write("%s - - [%s] %s\n" % (self.client_address[0], self.log_date_time_string(), fmt % args))

    def send_json(self, status: int, payload: dict[str, Any]) -> None:
        body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def send_html(self, body: str) -> None:
        data = body.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self) -> None:
        parsed = urlparse(self.path)
        try:
            if parsed.path == "/":
                self.send_html(html_page(self.app.csrf))
                return
            if parsed.path == "/api/summary":
                self.send_json(200, self.app.summary())
                return
            if parsed.path == "/api/slot":
                params = parse_qs(parsed.query)
                slot = first_param(params, "slot")
                self.send_json(200, self.app.slot_detail(slot))
                return
            self.send_json(404, {"error": "not found"})
        except Exception as exc:
            self.send_json(500, {"error": str(exc)})

    def do_HEAD(self) -> None:
        parsed = urlparse(self.path)
        if parsed.path != "/":
            self.send_response(404)
            self.end_headers()
            return
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()

    def do_POST(self) -> None:
        parsed = urlparse(self.path)
        if parsed.path != "/api/action":
            self.send_json(404, {"error": "not found"})
            return

        token = self.headers.get("X-CSRF-Token", "")
        if token != self.app.csrf:
            self.send_json(403, {"error": "invalid CSRF token"})
            return

        try:
            length = int(self.headers.get("Content-Length", "0"))
            if length > 32 * 1024:
                self.send_json(413, {"error": "request too large"})
                return
            payload = json.loads(self.rfile.read(length).decode("utf-8") or "{}")
            action = str(payload.get("action", ""))
            if not action:
                raise ValueError("missing action")
            self.send_json(200, self.app.execute_action(action, payload))
        except Exception as exc:
            self.send_json(400, {"error": str(exc)})


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="OpenClaw localhost ops console")
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=18088)
    parser.add_argument("--registry", default=DEFAULT_REGISTRY)
    parser.add_argument("--images", default=DEFAULT_IMAGES)
    parser.add_argument("--manifest", default=DEFAULT_MANIFEST)
    parser.add_argument("--health-report", default=DEFAULT_HEALTH_REPORT)
    parser.add_argument("--drift-report", default=DEFAULT_DRIFT_REPORT)
    parser.add_argument("--actions-log", default=DEFAULT_ACTIONS_LOG)
    parser.add_argument("--control", default=DEFAULT_CONTROL)
    parser.add_argument("--base-domain", default="ji-tech.co.kr")
    parser.add_argument("--max-output-bytes", type=int, default=DEFAULT_MAX_OUTPUT_BYTES)
    parser.add_argument("--no-sudo", action="store_true", help=argparse.SUPPRESS)
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    validate_loopback(args.host)
    if args.max_output_bytes < 4096 or args.max_output_bytes > 256 * 1024:
        raise SystemExit("error: --max-output-bytes must be between 4096 and 262144")

    app = OpsConsole(args)
    server = ThreadingHTTPServer((args.host, args.port), RequestHandler)
    server.app = app  # type: ignore[attr-defined]
    print(f"openclaw_ops_console=http://{args.host}:{args.port}", flush=True)
    server.serve_forever()
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
