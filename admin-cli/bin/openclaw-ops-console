  <script>
    const CSRF = {token};
    let state = null;
    let selectedSlot = "";

    function escapeHtml(value) {{
      return String(value ?? "").replace(/[&<>"']/g, ch => ({{
        "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
      }}[ch]));
    }}

    function stateClass(value) {{
      const text = String(value || "").toLowerCase();
      if (["pass", "ready", "ok", "match", "active_test"].includes(text)) return "ok";
      if (["fail", "failed", "mismatch"].includes(text)) return "bad";
      if (["warn", "warning", "missing", "assigned", "paused", "turnover_needed"].includes(text)) return "warn";
      return "";
    }}

    function displayValue(value, fallback = "missing") {{
      const text = String(value || fallback);
      const map = {{
        "PASS": "정상",
        "pass": "정상",
        "FAIL": "실패",
        "fail": "실패",
        "WARN": "주의",
        "missing": "없음",
        "ready": "준비됨",
        "assigned": "배정됨",
        "active_test": "테스트중",
        "paused": "일시중지",
        "revoked": "회수됨",
        "turnover_needed": "초기화 필요",
        "match": "일치",
        "mismatch": "불일치"
      }};
      return map[text] || text;
    }}

    function pill(value) {{
      const text = String(value || "missing");
      return `<span class="pill ${{stateClass(text)}}">${{escapeHtml(displayValue(text))}}</span>`;
    }}

    function metric(label, value, cls = "", hint = "") {{
      return `<div class="metric"><div class="label">${{escapeHtml(label)}}</div><div class="value ${{cls}}">${{escapeHtml(value)}}</div><div class="hint">${{escapeHtml(hint)}}</div></div>`;
    }}

    function isAttention(slot) {{
      return slot.drift_result === "FAIL"
        || slot.drift_result === "missing"
        || slot.gate_status === "fail"
        || slot.status === "turnover_needed"
        || slot.status === "paused"
        || slot.status === "revoked";
    }}

    function updateBanner() {{
      const drift = state.drift || {{}};
      const baselineOk = !!(state.baseline || {{}}).match;
      const driftOk = drift.summary === "PASS";
      const failed = Number(state.failed_slots || 0);
      const banner = document.getElementById("opsBanner");
      let cls = "ok";
      let title = "현재 운영 상태는 정상입니다.";
      let line = "기준 버전과 drift 결과가 맞고, 실패 slot이 없습니다.";
      if (!baselineOk || !driftOk || failed > 0) {{
        cls = "bad";
        title = "확인이 필요한 운영 상태가 있습니다.";
        line = `baseline=${{baselineOk ? "일치" : "불일치"}}, drift=${{displayValue(drift.summary)}}, failed_slots=${{failed}}`;
      }} else if ((state.ollama_status || {{}}).exit_code !== 0 || (state.usage_summary || {{}}).exit_code !== 0) {{
        cls = "warn";
        title = "핵심 상태는 정상이나 보조 점검이 필요합니다.";
        line = "Ollama 또는 사용량 확인 명령을 다시 확인하세요.";
      }}
      banner.className = `banner ${{cls}}`;
      banner.querySelector(".banner-title").textContent = title;
      banner.querySelector(".banner-line").textContent = line;
    }}

    async function fetchJson(url, options = {{}}) {{
      const response = await fetch(url, options);
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || response.statusText);
      return data;
    }}

    async function refreshSummary() {{
      document.getElementById("summary").innerHTML = metric("불러오는 중", "...", "", "서버 상태를 읽고 있습니다.");
      state = await fetchJson("/api/summary");
      renderSummary();
      renderSlots();
      if (!selectedSlot && state.slots.length) selectSlot(state.slots[0].slot);
    }}

    function renderSummary() {{
      const baseline = state.baseline || {{}};
      const drift = state.drift || {{}};
      const ollama = state.ollama_status || {{}};
      const usage = state.usage_summary || {{}};
      const baselineValue = baseline.match ? "일치" : "불일치";
      const failed = Number(state.failed_slots || 0);
      const attention = state.slots.filter(isAttention).length;
      const summary = [
        metric("기준 버전", baselineValue, baseline.match ? "ok" : "bad", baseline.installed_commit ? baseline.installed_commit.slice(0, 12) : "설치 manifest 확인"),
        metric("Drift", displayValue(drift.summary), drift.summary === "PASS" ? "ok" : "bad", drift.finished || "최근 리포트 없음"),
        metric("확인 필요 슬롯", attention, attention ? "warn" : "ok", `실패 ${{failed}}개 / 전체 ${{state.slot_count || 0}}개`),
        metric("Ollama", ollama.exit_code === 0 ? "정상" : "확인 필요", ollama.exit_code === 0 ? "ok" : "warn", "공용 로컬 모델 상태"),
        metric("사용량 점검", usage.exit_code === 0 ? "정상" : "확인 필요", usage.exit_code === 0 ? "ok" : "warn", "최근 호출량 확인"),
        metric("외부 연동", "대기", "muted", "그룹웨어/카카오워크 접근권 필요")
      ];
      document.getElementById("summary").innerHTML = summary.join("");
      document.getElementById("refreshedAt").textContent = `갱신 ${{state.generated_at || ""}}`;
      updateBanner();
    }}

    function renderSlots() {{
      const tbody = document.getElementById("slots");
      const query = document.getElementById("slotSearch").value.trim().toLowerCase();
      const filter = document.getElementById("slotFilter").value;
      const rows = state.slots.filter(slot => {{
        const haystack = [slot.slot, slot.status, slot.subdomain, slot.nas_share, slot.mount_name, slot.assignee].join(" ").toLowerCase();
        if (query && !haystack.includes(query)) return false;
        if (filter === "attention") return isAttention(slot);
        if (filter === "assigned") return !!slot.assignee || slot.status === "assigned";
        if (filter === "ready") return slot.status === "ready";
        if (filter === "active_test") return slot.status === "active_test";
        return true;
      }});
      document.getElementById("slotCountLabel").textContent = `${{rows.length}} / ${{state.slots.length}} 표시`;
      tbody.innerHTML = rows.map(slot => `
        <tr onclick="selectSlot('${{escapeHtml(slot.slot)}}')" data-slot="${{escapeHtml(slot.slot)}}" data-selected="${{slot.slot === selectedSlot}}">
          <td><div class="slot-name">${{escapeHtml(slot.slot)}}</div><div class="subline">${{escapeHtml(slot.assignee || "미배정")}}</div></td>
          <td>${{pill(slot.status)}}<div class="subline">SSH ${{escapeHtml(slot.handoff_ssh || "-")}} / Token ${{escapeHtml(slot.handoff_token || "-")}}</div></td>
          <td>${{escapeHtml(slot.subdomain)}}<div class="subline">${{escapeHtml(slot.handoff_url || "")}}</div></td>
          <td>${{escapeHtml(slot.mount_name || "")}}<br><span class="muted">${{escapeHtml(slot.nas_share || "")}}</span></td>
          <td>${{pill(slot.gate_status || "unknown")}}<br><span class="muted">${{escapeHtml(slot.gate_checked_at || "")}}</span></td>
          <td>${{pill(slot.drift_result)}}</td>
        </tr>
      `).join("");
      for (const row of tbody.querySelectorAll("tr")) {{
        const slot = state.slots.find(item => item.slot === row.dataset.slot) || {{}};
        row.dataset.attention = String(isAttention(slot));
        row.dataset.failed = String(slot.drift_result === "FAIL" || slot.gate_status === "fail");
      }}
    }}

    function selectSlot(slot) {{
      selectedSlot = slot;
      renderSlots();
      const item = state.slots.find(row => row.slot === slot) || {{}};
      document.getElementById("detailTitle").textContent = `${{slot}} 상세`;
      document.getElementById("slotMeta").innerHTML =
        `${{escapeHtml(item.subdomain || "")}} · ${{escapeHtml(item.nas_share || "")}} · ${{escapeHtml(item.image_tag || "")}}`;
      document.getElementById("slotCards").innerHTML = `
        <div class="slot-card"><div class="label">운영 상태</div><div class="value">${{pill(item.status)}}</div></div>
        <div class="slot-card"><div class="label">Release gate</div><div class="value">${{pill(item.gate_status || "missing")}}</div><div class="subline">${{escapeHtml(item.gate_checked_at || "")}}</div></div>
        <div class="slot-card"><div class="label">Drift</div><div class="value">${{pill(item.drift_result)}}</div><div class="subline">${{isAttention(item) ? "확인 필요" : "정상 범위"}}</div></div>
      `;
    }}

    async function loadSlotDetail() {{
      if (!selectedSlot) return;
      setOutput("슬롯 상태를 불러오는 중입니다...");
      const data = await fetchJson(`/api/slot?slot=${{encodeURIComponent(selectedSlot)}}`);
      const text = Object.entries(data.commands).map(([name, result]) =>
        `## ${{name}}\\nexit=${{result.exit_code}} duration_ms=${{result.duration_ms}}\\n${{result.output}}`
      ).join("\\n\\n");
      setOutput(text, "slot status");
    }}

    function actionParams(action) {{
      return {{
        action,
        slot: selectedSlot,
        model: document.getElementById("model").value,
        base_url: document.getElementById("baseUrl").value,
        share: document.getElementById("share").value,
        confirm: document.getElementById("confirm").value,
        since: "24h"
      }};
    }}

    function isNasMutation(action) {{
      return ["nas-approve-share", "nas-register", "nas-unregister"].includes(action);
    }}

    function updateNasActionState() {{
      const unlocked = !!document.getElementById("nasUnlock")?.checked;
      for (const button of document.querySelectorAll(".nas-action")) {{
        button.disabled = !unlocked || document.body.classList.contains("is-busy");
      }}
    }}

    function setBusy(isBusy) {{
      document.body.classList.toggle("is-busy", isBusy);
      for (const button of document.querySelectorAll("button")) {{
        if (button.classList.contains("nas-action")) {{
          continue;
        }}
        button.disabled = isBusy;
      }}
      updateNasActionState();
    }}

    async function runSlotAction(action) {{
      if (!selectedSlot) return;
      if (isNasMutation(action) && !document.getElementById("nasUnlock").checked) {{
        setOutput("NAS 변경은 먼저 'NAS 변경 버튼 활성화'를 체크해야 실행됩니다.", action);
        return;
      }}
      await runAction(actionParams(action));
    }}

    async function runGlobalAction(action) {{
      await runAction({{ action }});
    }}

    async function runAction(params) {{
      setOutput("실행 중입니다...");
      setBusy(true);
      try {{
        const data = await fetchJson("/api/action", {{
          method: "POST",
          headers: {{ "Content-Type": "application/json", "X-CSRF-Token": CSRF }},
          body: JSON.stringify(params)
        }});
        const result = data.result;
        setOutput(`exit=${{result.exit_code}} duration_ms=${{result.duration_ms}}\\n${{result.output}}`, params.action);
        if (["check", "nas-verify", "gateway-refresh", "heartbeat-disable", "heartbeat-ollama", "ollama-provider", "ollama-default", "nas-approve-share", "nas-register", "nas-unregister"].includes(params.action)) {{
          await refreshSummary();
          if (selectedSlot) selectSlot(selectedSlot);
        }}
      }} catch (error) {{
        setOutput(`ERROR: ${{error.message}}`, params.action);
      }} finally {{
        setBusy(false);
      }}
    }}

    function setOutput(text, label = "") {{
      document.getElementById("output").textContent = text;
      document.getElementById("lastRun").textContent = label;
    }}

    updateNasActionState();
    refreshSummary().catch(error => setOutput(`ERROR: ${{error.message}}`, "summary"));
  </script>
</body>
</html>
"""


class RequestHandler(BaseHTTPRequestHandler):
    server_version = "OpenClawOpsConsole/1.0"

    @property
    def app(self) -> OpsConsole:
        return self.server.app  # type: ignore[attr-defined]

    def log_message(self, fmt: str, *args: Any) -> None:
        sys.stderr.write("%s - - [%s] %s\n" % (self.client_address[0], self.log_date_time_string(), fmt % args))

    def send_json(self, status: int, payload: dict[str, Any]) -> None:
        body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def send_html(self, body: str) -> None:
        data = body.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self) -> None:
        parsed = urlparse(self.path)
        try:
            if parsed.path == "/":
                self.send_html(html_page(self.app.csrf))
                return
            if parsed.path == "/api/summary":
                self.send_json(200, self.app.summary())
                return
            if parsed.path == "/api/slot":
                params = parse_qs(parsed.query)
                slot = first_param(params, "slot")
                self.send_json(200, self.app.slot_detail(slot))
                return
            self.send_json(404, {"error": "not found"})
        except Exception as exc:
            self.send_json(500, {"error": str(exc)})

    def do_HEAD(self) -> None:
        parsed = urlparse(self.path)
        if parsed.path != "/":
            self.send_response(404)
            self.end_headers()
            return
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()

    def do_POST(self) -> None:
        parsed = urlparse(self.path)
        if parsed.path != "/api/action":
            self.send_json(404, {"error": "not found"})
            return

        token = self.headers.get("X-CSRF-Token", "")
        if token != self.app.csrf:
            self.send_json(403, {"error": "invalid CSRF token"})
            return

        try:
            length = int(self.headers.get("Content-Length", "0"))
            if length > 32 * 1024:
                self.send_json(413, {"error": "request too large"})
                return
            payload = json.loads(self.rfile.read(length).decode("utf-8") or "{}")
            action = str(payload.get("action", ""))
            if not action:
                raise ValueError("missing action")
            self.send_json(200, self.app.execute_action(action, payload))
        except Exception as exc:
            self.send_json(400, {"error": str(exc)})


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="OpenClaw localhost ops console")
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=18088)
    parser.add_argument("--registry", default=DEFAULT_REGISTRY)
    parser.add_argument("--manifest", default=DEFAULT_MANIFEST)
    parser.add_argument("--drift-report", default=DEFAULT_DRIFT_REPORT)
    parser.add_argument("--actions-log", default=DEFAULT_ACTIONS_LOG)
    parser.add_argument("--control", default=DEFAULT_CONTROL)
    parser.add_argument("--base-domain", default="ji-tech.co.kr")
    parser.add_argument("--max-output-bytes", type=int, default=DEFAULT_MAX_OUTPUT_BYTES)
    parser.add_argument("--no-sudo", action="store_true", help=argparse.SUPPRESS)
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    validate_loopback(args.host)
    if args.max_output_bytes < 4096 or args.max_output_bytes > 256 * 1024:
        raise SystemExit("error: --max-output-bytes must be between 4096 and 262144")

    app = OpsConsole(args)
    server = ThreadingHTTPServer((args.host, args.port), RequestHandler)
    server.app = app  # type: ignore[attr-defined]
    print(f"openclaw_ops_console=http://{args.host}:{args.port}", flush=True)
    server.serve_forever()
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
